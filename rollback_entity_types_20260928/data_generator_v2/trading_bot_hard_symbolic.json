{
  "domain": "trading_bot_hard",
  "tool_schema": "../../data/multi_turn_func_doc/trading_bot_hard.json",
  "state_specs": "../data_v2/trading_bot_hard",
  "lifecycle_rules": "trading_bot_hard_lifecycle.json",
  "output_root": "../trajectories_v2/trading_bot_hard/symbolic",
  "state_conditions": {
    "$.state_before.authenticated": true,
    "$.state_before.long_context": false
  },
  "entity_types": {
    "account": {
      "paths": ["$.state_before.account_info"],
      "fields": {
        "balance": "$.state_before.account_info.balance",
        "account_id": "$.state_before.account_info.account_id"
      }
    },
    "history": {
      "paths": ["$.state_before.transaction_history"],
      "fields": {"records": "$.state_before.transaction_history"}
    },
    "order": {
      "paths": ["$.state_before.orders['{id}']"],
      "fields": {
        "status": "$.state_before.orders['{id}'].status",
        "amount": "$.state_before.orders['{id}'].amount",
        "symbol": "$.state_before.orders['{id}'].symbol",
        "price": "$.state_before.orders['{id}'].price"
      },
      "relations": {
        "symbol": {
          "type": "stock",
          "slots": ["order.symbol"],
          "arguments": {"place_order": "$.args.symbol"}
        }
      }
    },
    "stock": {
      "paths": ["$.state_before.stocks['{id}']", "$.state_before.holdings['{id}']"],
      "fields": {
        "price": "$.state_before.stocks['{id}'].price",
        "holding": "$.state_before.holdings['{id}']"
      }
    }
  },
  "targets": {
    "balance": {
      "path": "$.state_before.account_info.balance",
      "entity_type": "account",
      "entity": "account",
      "field": "balance"
    },
    "transaction_history": {
      "path": "$.state_before.transaction_history",
      "entity_type": "history",
      "entity": "history",
      "field": "records"
    },
    "orders": {
      "path": "$.state_before.orders['{target_order_id}'].status",
      "entity_type": "order",
      "entity": "orders",
      "field": "status",
      "scope": "The status of one symbolic order, not the complete orders mapping.",
      "identity_condition": "The anchor, status writers, and final reader refer to the same symbolic order ID; that order exists and starts Pending."
    },
    "holdings": {
      "path": "$.state_before.holdings['{target_symbol}']",
      "entity_type": "stock",
      "entity": "stock",
      "field": "holding",
      "default": false
    }
  },
  "reader_refinements": [
    {
      "tool": "get_transaction_history",
      "branch": "success_filtered_history",
      "field": "$.result.transaction_history",
      "source": "$.state_before.transaction_history",
      "recoverability": "conditional",
      "condition": "Omit both optional date bounds and require long_context to be false; then the filter returns the full ordered history."
    }
  ],
  "writer_sequences": {
    "balance": [
      ["fund_account:success_funded", "withdraw_funds:success_withdrawal"],
      ["withdraw_funds:success_withdrawal", "fund_account:success_funded"],
      ["fund_account:success_funded", "withdraw_funds:success_withdrawal", "fund_account:success_funded"],
      ["withdraw_funds:success_withdrawal", "fund_account:success_funded", "withdraw_funds:success_withdrawal"]
    ],
    "transaction_history": [
      ["fund_account:success_funded", "withdraw_funds:success_withdrawal"],
      ["withdraw_funds:success_withdrawal", "fund_account:success_funded"],
      ["fund_account:success_funded", "withdraw_funds:success_withdrawal", "fund_account:success_funded"],
      ["withdraw_funds:success_withdrawal", "fund_account:success_funded", "withdraw_funds:success_withdrawal"]
    ],
    "orders": [
      ["activate_order:success_activated", "cancel_order:success_cancelled"]
    ]
  }
}
