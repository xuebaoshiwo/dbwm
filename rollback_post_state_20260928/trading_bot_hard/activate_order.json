{
  "schema_version": "1.1",
  "tool": "activate_order",
  "branches": [
    {
      "id": "error_order_not_found",
      "if": "$.args.order_id not in $.state_before.orders",
      "uses": [
        "$.args.order_id",
        "$.state_before.orders"
      ],
      "description": "The requested order ID does not exist in the orders store."
    },
    {
      "id": "error_order_not_pending",
      "if": "$.state_before.orders['{args.order_id}'].status != 'Pending'",
      "uses": [
        "$.args.order_id",
        "$.state_before.orders['{args.order_id}'].status"
      ],
      "description": "The requested order exists but its status is not Pending, so it cannot be activated."
    },
    {
      "id": "success_activated",
      "if": "otherwise",
      "uses": [],
      "description": "The order exists and is Pending, so the backend changes its status to Open and returns the activated order ID and new status."
    }
  ],
  "mutations": [
    {
      "branch": "success_activated",
      "target": "$.state_after.orders['{args.order_id}'].status",
      "operation": "set",
      "value_from": [],
      "external_from": [],
      "logic": "Sets the order status to the constant value 'Open'.",
      "state_source_relations": []
    }
  ],
  "returns": [
    {
      "branch": "error_order_not_found",
      "fields": [
        {
          "path": "$.result.error",
          "source_kind": "derived",
          "value_from": [
            "$.args.order_id"
          ],
          "external_from": [],
          "logic": "Formats an error message that includes the missing order ID.",
          "state_source_relations": []
        }
      ]
    },
    {
      "branch": "error_order_not_pending",
      "fields": [
        {
          "path": "$.result.error",
          "source_kind": "derived",
          "value_from": [
            "$.args.order_id",
            "$.state_before.orders['{args.order_id}'].status"
          ],
          "external_from": [],
          "logic": "Formats an error message using the input order ID and the lowercased current order status.",
          "state_source_relations": [
            {
              "path": "$.state_before.orders['{args.order_id}'].status",
              "transform": "format",
              "recoverability": "partial",
              "given": [],
              "reason": "The status is lowercased in the message, so its original spelling is lost."
            }
          ]
        }
      ]
    },
    {
      "branch": "success_activated",
      "fields": [
        {
          "path": "$.result.order_id",
          "source_kind": "arg_direct",
          "source": "$.args.order_id",
          "logic": "Returns the input order ID unchanged.",
          "state_source_relations": []
        },
        {
          "path": "$.result.status",
          "source_kind": "constant",
          "value": "Open",
          "logic": "Returns the literal status string 'Open' after successful activation.",
          "state_source_relations": []
        }
      ]
    }
  ],
  "warnings": [
    {
      "type": "schema_backend_mismatch",
      "description": "The tool schema response defines only order_id and status properties, but backend error branches return a dictionary containing only an 'error' field. The schema does not document this error field.",
      "schema_path": "$.response.properties",
      "backend_path": "$.result.error"
    }
  ]
}
